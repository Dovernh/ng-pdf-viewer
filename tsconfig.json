/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      // Point at the library source so the showcase consumes it live via `ng serve`.
      // Editing the lib is reflected immediately — no build/pack needed until CI packs it.
      "ng-pdf-viewer-lib": ["./projects/ng-pdf-viewer-lib/src/public-api.ts"]
    },
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/ng-pdf-viewer-lib/tsconfig.lib.json"
    },
    {
      "path": "./projects/ng-pdf-viewer-lib/tsconfig.spec.json"
    },
    {
      "path": "./projects/showcase/tsconfig.app.json"
    },
    {
      "path": "./projects/showcase/tsconfig.spec.json"
    }
  ]
}
